---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('news');
  return items.map((p) => ({ params: { slug: p.data.slug }, props: { item: p } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const full = `${item.data.title} | Peptides of China`;
const seoTitle = full.length <= 60 ? full : (item.data.title.length <= 60 ? item.data.title : item.data.title.slice(0, 57).trimEnd() + '…');
---
<BaseLayout title={seoTitle} description={item.data.description}>
  <p class="crumbs"><a href="/news/">News</a> ›</p>
  <div class="article-shell">
    <header class="article-header">
      <h1>{item.data.title}</h1>
      {item.data.description && <p class="lede">{item.data.description}</p>}
    </header>
    <article>
      <Content />
    </article>
    <p class="muted"><a href="/news/">← All news</a></p>
  </div>
</BaseLayout>
