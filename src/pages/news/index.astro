---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const items = await getCollection('news');
---
<BaseLayout
  title="News — Peptides of China"
  description="Updates and announcements from Peptides of China: sourcing, quality, and platform news."
>
  <div class="article-header">
    <h1>News</h1>
    <p class="lede">{items.length} updates.</p>
  </div>
  <div class="grid">
    {items.map((p) => (
      <a href={`/news/${p.data.slug}/`} class="card">
        <strong class="card-title">{p.data.title}</strong>
        <span class="meta">{p.data.description || ''}</span>
      </a>
    ))}
  </div>
</BaseLayout>
