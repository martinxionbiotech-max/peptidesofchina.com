---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const products = await getCollection('products');
products.sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));

const catGroups = new Map<string, typeof products>();
for (const p of products) {
  const c = p.data.category || 'Research Peptides';
  if (!catGroups.has(c)) catGroups.set(c, []);
  catGroups.get(c)!.push(p);
}
---
<BaseLayout
  title="China Peptide Catalog | Peptides of China"
  description="Complete catalog of research peptides manufactured in China: peptides, blends, and compounds with batch-tested purity, direct factory sourcing, and international shipping."
>
  <div class="article-header">
    <h1>China Peptide Catalog</h1>
    <p class="lede">
      {products.length} research compounds in stock — manufactured in established Chinese facilities,
      batch-tested for purity, shipped internationally. Catalog quantities start from one kit of 10
      vials per product.
    </p>
  </div>
  <div class="notice">
    <strong>B2B sourcing platform.</strong> Peptides of China coordinates factory sourcing, availability
    confirmation, specifications, order processing, international logistics, and delivery support for
    private brands, resellers, and research buyers.
  </div>

  <div class="card" style="flex-direction:row;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin:1.3rem 0">
    <div>
      <strong style="font-size:1.1rem">📄 Latest Price List (PDF)</strong>
      <p class="meta" style="margin:0.2rem 0 0">All catalog prices in one file — USD per box, 10 vials per box.</p>
    </div>
    <a href="/pricelist.pdf" class="btn">Download Price List</a>
  </div>

  {[...catGroups.entries()].map(([cat, items]) => (
    <section>
      <h2>{cat}</h2>
      <div class="grid">
        {items.map((p) => (
          <a href={`/catalog/${p.data.slug}/`} class="card">
            {p.data.image && (
              <img class="card-thumb" src={p.data.image} alt={`${p.data.name} — research peptide from China`} loading="lazy" width="240" height="240" />
            )}
            <strong class="card-title">{p.data.name}</strong>
            <span class="meta">{p.data.specification || p.data.purity || '10 vials'} · {p.data.status}</span>
          </a>
        ))}
      </div>
    </section>
  ))}

  <div class="disclaimer">
    <strong>Research use only.</strong> All products in this catalog are intended for laboratory
    research purposes. They are not for human or veterinary use, and are not medicines, dietary
    supplements, or cosmetics.
  </div>
</BaseLayout>
