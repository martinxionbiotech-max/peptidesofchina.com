---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((p) => ({ params: { slug: p.data.slug }, props: { product: p } }));
}

const { product } = Astro.props;
const { Content } = await render(product);
const { title, name, purity, specification, status, image } = product.data;
const base = `Buy ${name} | China Peptide — Peptides of China`;
const seoTitle = base.length <= 60 ? base : `Buy ${name.slice(0, 37).trimEnd()}… | China Peptide`;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: title,
    description: `${name} — research peptide from China. Research use only.`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${Astro.site}` },
      { '@type': 'ListItem', position: 2, name: 'Catalog', item: `${Astro.site}catalog/` },
      { '@type': 'ListItem', position: 3, name: name, item: `${Astro.site}catalog/${product.data.slug}/` },
    ],
  },
];
---
<BaseLayout title={seoTitle} description={`${name}: research peptide from China. ${purity || '≥98% purity'}, batch-tested, direct factory sourcing, international shipping.`}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <p class="crumbs"><a href="/catalog/">Catalog</a> › {name}</p>
  <h1>{title}</h1>

  <div class="product-layout">
    {image && (
      <figure class="product-media">
        <img src={image} alt={`${name} — research peptide from China`} width="380" height="380" />
      </figure>
    )}
    <aside class="price-card">
      <div class="price-line">
        <span class="price-value">Latest Price List</span>
        <span class="badge">{status}</span>
      </div>
      <p class="price-note">{specification || '10 vials per kit'} · Prices in current catalog PDF</p>
      <dl class="spec-rows">
        <div><dt>Purity</dt><dd>{purity || '≥98%'}</dd></div>
        <div><dt>Packaging</dt><dd>{specification || '10 vials per kit'}</dd></div>
        <div><dt>Availability</dt><dd>{status}</dd></div>
      </dl>
      <div class="actions">
        <a class="btn" href="/pricelist.pdf">📄 Download Latest Price List (PDF)</a>
        <a class="btn btn-ghost" href="/contact/">Ask About This Product</a>
      </div>
    </aside>
  </div>

  <div class="article-shell">
    <article>
      <Content />
    </article>
  </div>

  <div class="disclaimer">
    <strong>Research use only.</strong> This product is a research compound intended for laboratory
    research purposes. It is not for human or veterinary use, and is not a medicine, dietary
    supplement, or cosmetic.
  </div>

  <p class="muted"><a href="/catalog/">← Back to the full china peptide catalog</a></p>
</BaseLayout>
