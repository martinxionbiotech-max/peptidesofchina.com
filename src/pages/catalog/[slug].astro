---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((p) => ({ params: { slug: p.data.slug }, props: { product: p } }));
}

const { product } = Astro.props;
const { Content } = await render(product);
const { title, name, price, purity, specification, status, image } = product.data;
const base = `Buy ${name} | China Peptide — Peptides of China`;
const seoTitle = base.length <= 60 ? base : `Buy ${name.slice(0, 37).trimEnd()}… | China Peptide`;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: title,
    description: `${name} — research peptide from China. Research use only.`,
    offers: {
      '@type': 'Offer',
      price: price,
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${Astro.site}` },
      { '@type': 'ListItem', position: 2, name: 'Catalog', item: `${Astro.site}catalog/` },
      { '@type': 'ListItem', position: 3, name: name, item: `${Astro.site}catalog/${product.data.slug}/` },
    ],
  },
];
---
<BaseLayout title={seoTitle} description={`${name}: research peptide from China. ${purity || '≥98% purity'}, batch-tested, direct factory sourcing, international shipping.`}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <p class="muted"><a href="/catalog/">Catalog</a> › {name}</p>
  <h1>{title}</h1>

  <div style="display:flex;gap:1.5rem;flex-wrap:wrap;align-items:flex-start">
    {image && (
      <img src={image} alt={`${name} — research peptide from China`} width="360" height="360" style="border-radius:8px;max-width:360px;width:100%;aspect-ratio:1;object-fit:cover;background:var(--bg-soft);border:1px solid var(--border)" />
    )}
    <div class="card" style="max-width:420px;flex:1;min-width:240px">
      <span class="badge">{status}</span>
      <strong style="font-size:1.5rem">${price.toFixed(2)}</strong>
      <span class="meta">{specification || '10 vials per kit'} · {purity || '≥98% purity'}</span>
    </div>
  </div>

  <article>
    <Content />
  </article>

  <div class="disclaimer">
    <strong>Research use only.</strong> This product is a research compound intended for laboratory
    research purposes. It is not for human or veterinary use, and is not a medicine, dietary
    supplement, or cosmetic.
  </div>

  <p class="muted"><a href="/catalog/">← Back to the full china peptide catalog</a></p>
</BaseLayout>
