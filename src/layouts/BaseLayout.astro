---
interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description || title} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <style is:global>
      :root {
        --bg: #0b1220;
        --bg-soft: #111a2c;
        --text: #e6edf7;
        --text-muted: #9aa7bd;
        --accent: #3b82f6;
        --accent-soft: #1d4ed8;
        --border: #1f2b40;
        --ok: #34d399;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        background: var(--bg);
        color: var(--text);
        font-family: -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        line-height: 1.65;
      }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }
      .wrap { max-width: 1100px; margin: 0 auto; padding: 0 1.25rem; }
      header.site {
        border-bottom: 1px solid var(--border);
        background: var(--bg-soft);
        padding: 0.9rem 0;
      }
      .site-inner { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; }
      .brand { font-weight: 700; font-size: 1.15rem; color: var(--text); }
      nav.main { display: flex; gap: 1.1rem; flex-wrap: wrap; font-size: 0.92rem; }
      main { min-height: 60vh; padding: 2.5rem 0; }
      h1 { font-size: 2.1rem; line-height: 1.2; margin-bottom: 1rem; }
      h2 { font-size: 1.45rem; margin: 2rem 0 0.8rem; }
      h3 { font-size: 1.12rem; margin: 1.4rem 0 0.6rem; }
      p { margin-bottom: 0.9rem; }
      ul, ol { margin: 0 0 1rem 1.4rem; }
      li { margin-bottom: 0.35rem; }
      table { width: 100%; border-collapse: collapse; margin: 1rem 0 1.4rem; font-size: 0.94rem; }
      th, td { border: 1px solid var(--border); padding: 0.55rem 0.8rem; text-align: left; }
      th { background: var(--bg-soft); }
      .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1rem; margin: 1.2rem 0; }
      .card {
        background: var(--bg-soft);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 1rem 1.1rem;
        display: flex; flex-direction: column; gap: 0.35rem;
      }
      .card .price { color: var(--ok); font-weight: 600; }
      .card .meta { color: var(--text-muted); font-size: 0.85rem; }
      .badge { display: inline-block; background: var(--accent-soft); color: #fff; border-radius: 4px; padding: 0.1rem 0.5rem; font-size: 0.75rem; }
      .muted { color: var(--text-muted); }
      .notice {
        background: var(--bg-soft);
        border-left: 3px solid var(--accent);
        padding: 0.8rem 1rem;
        margin: 1.2rem 0;
        font-size: 0.95rem;
      }
      footer.site {
        border-top: 1px solid var(--border);
        padding: 2rem 0;
        color: var(--text-muted);
        font-size: 0.88rem;
      }
      .disclaimer {
        background: #1a120b;
        border: 1px solid #3a2a12;
        border-radius: 6px;
        padding: 0.8rem 1rem;
        margin: 1.4rem 0;
        font-size: 0.88rem;
        color: #d8b98a;
      }
    </style>
  </head>
  <body>
    <header class="site">
      <div class="wrap site-inner">
        <a href="/" class="brand">Peptides of China</a>
        <nav class="main">
          <a href="/catalog/">Catalog</a>
          <a href="/blog/">Blog</a>
          <a href="/news/">News</a>
          <a href="/how-it-works/">How It Works</a>
          <a href="/peptide-quality/">Quality</a>
          <a href="/faq/">FAQ</a>
          <a href="/contact/">Contact</a>
        </nav>
      </div>
    </header>
    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site">
      <div class="wrap">
        <p><strong>Peptides of China</strong> — B2B sourcing platform for research peptides manufactured in China.</p>
        <p>
          <a href="/research-use-disclaimer/">Research Use Disclaimer</a> ·
          <a href="/terms-and-conditions/">Terms</a> ·
          <a href="/privacy-and-cookie-policy/">Privacy</a> ·
          <a href="/shipping-and-reshipment-policy/">Shipping</a> ·
          <a href="/refund-and-cancellation-policy/">Refunds</a>
        </p>
        <p class="muted">All products are intended for laboratory research use only.</p>
      </div>
    </footer>
  </body>
</html>
